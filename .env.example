# Base Site URL (ใช้สำหรับสร้าง Deep Link บน LINE Message)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Supabase Service Role Key (API ระดับสูง Bypass RLS สำหรับ Server Actions / Admin)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# n8n Self-Hosted Webhook URL (อุปกรณ์เสริมสำหรับ Background Workflow)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/chat

# Google Gemini API Key (สำหรับ AI Progressive Intake & Clarification Engine)
GEMINI_API_KEY=your-gemini-api-key

# LINE OA Messaging API & Webhook Signature
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# รหัสยืนยันสำหรับลงทะเบียนสิทธิ์แอดมิน/เจ้าหน้าที่จุดรับฝาก
ADMIN_REGISTRATION_CODE=ADMIN1234
