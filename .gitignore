*.exe
*.zip
*.tar.gz

# env files (can opt-in for committing if needed)
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ai-agent & scratch
ai-agent/
scratch/
